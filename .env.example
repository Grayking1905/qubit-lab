# Neon pooled connection (used by the app for normal queries, via PgBouncer)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Neon direct connection (used only for `prisma migrate` / `prisma db push`)
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="10080"

# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# Frontend: base URL of the FastAPI backend
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Groq API (https://console.groq.com/keys) — powers /ai/chat and /ai/quiz/generate
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# Hardcoded admin credentials for the /admin/auth/login endpoint.
# This is completely separate from the DB user system — no database user is required.
# Change these before deploying to production.
ADMIN_EMAIL="admin@qubitlab.dev"
ADMIN_PASSWORD="change-me-admin-secret"
