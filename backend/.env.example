# Neon pooled connection (used by the app for normal queries, via PgBouncer)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Neon direct connection (used only for `prisma migrate` / `prisma db push`)
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="10080"

# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# Groq API (https://console.groq.com/keys) — powers /ai/chat and /ai/quiz/generate.
# Check https://console.groq.com/docs/models for what's currently available on
# your account — Groq's lineup changes over time and not every account has
# access to every model.
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"
